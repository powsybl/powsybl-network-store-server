    <!-- The data migration is skipped if the database is not postgres because it uses json methods that are specific to postgres -->
    <changeSet id="20261102-3" author="powsybl">
        <sqlFile
                dbms="postgresql"
                path="voltage_regulation_migration_20261102T100000Z.sql"
                relativeToChangelogFile="true"
                splitStatements="true"
                stripComments="true"/>
    </changeSet>
</databaseChangeLog>
